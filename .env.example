# ---------------------------------------------------------------------------
# Game of Cards — environment variables
# Copy this file to `.env` (cp .env.example .env). Every variable is optional
# for local development; sensible defaults are used when unset.
# ---------------------------------------------------------------------------

# Database connection.
#   SQLite (default, local):  file:./data/dev.db
#   Postgres (deployment):    postgres://user:password@host:5432/dbname
DATABASE_URL="file:./data/dev.db"

# Password for the /admin moderation view. When empty, /admin is disabled.
# CHANGE THIS before deploying anywhere public.
ADMIN_PASSWORD="change-me-locally"

# Secret used to sign the admin session cookie and to salt stored IP hashes.
# Any long random string. Falls back to a value derived from ADMIN_PASSWORD.
APP_SECRET="replace-with-a-long-random-string"

# Public base URL used for canonical links, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Rate limit for write endpoints (posts, comments, contact, ratings) per IP per minute.
RATE_LIMIT_PER_MINUTE="8"
